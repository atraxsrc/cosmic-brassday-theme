# BrassDay for delta (the git diff pager), part of cosmic-brassday-theme (MIT).
# Removed lines in the error colour, added lines in the success colour, both
# on the editor's container; changed words on a solid error / success block
# with the editor background as text (the same as DiffAdd / DiffDelete /
# DiffText in Neovim). Code inside the diff uses the bat BrassDay theme, so run
# ./bat/install.sh first.
#
# Install: ./delta/install.sh puts this in ~/.config/delta/, then add to
# ~/.gitconfig (the installer prints this, it never edits ~/.gitconfig):
#   [include]
#       path = ~/.config/delta/brassday.gitconfig
# and, if delta is not your pager yet:
#   [core]
#       pager = delta
#   [interactive]
#       diffFilter = delta --color-only

[delta]
    features = brassday

[delta "brassday"]
    light = true
    syntax-theme = BrassDay
    navigate = true
    line-numbers = true

    file-style = bold "#77603B"
    file-decoration-style = "#E3D8BB" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#E3D8BB" box
    hunk-header-file-style = "#70614C"
    hunk-header-line-number-style = "#6F5F36"

    minus-style = "#A63426" "#FBF5E7"
    minus-emph-style = bold "#F4ECD6" "#A63426"
    minus-non-emph-style = "#A63426" "#FBF5E7"
    plus-style = "#7C602C" "#FBF5E7"
    plus-emph-style = bold "#F4ECD6" "#7C602C"
    plus-non-emph-style = "#7C602C" "#FBF5E7"
    zero-style = syntax
    whitespace-error-style = "#F4ECD6" "#9E4E1A"

    line-numbers-left-style = "#E3D8BB"
    line-numbers-right-style = "#E3D8BB"
    line-numbers-minus-style = "#A63426"
    line-numbers-plus-style = "#7C602C"
    line-numbers-zero-style = "#9A978C"

    commit-style = bold "#6F5F36"
    commit-decoration-style = "#E3D8BB" box
    blame-palette = "#F4ECD6 #FBF5E7 #EDE3C9"
    blame-code-style = syntax
    merge-conflict-begin-symbol = ▼
    merge-conflict-end-symbol = ▲
    merge-conflict-ours-diff-header-style = bold "#7C602C"
    merge-conflict-theirs-diff-header-style = bold "#9E4E1A"
