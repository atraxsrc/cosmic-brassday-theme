# BrassDay for Ghostty, part of cosmic-brassday-theme (MIT).
# Colours follow the COSMIC Terminal scheme (cosmic-term/).
#
# Install: ./ghostty/install.sh puts this in ~/.config/ghostty/themes/, then in
# ~/.config/ghostty/config:
#   theme = BrassDay
# or, with the Brass half installed too, following COSMIC's Dark / Light toggle:
#   theme = dark:Brass,light:BrassDay

